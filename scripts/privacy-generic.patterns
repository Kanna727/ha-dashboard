# Generic, non-private checks run by scripts/privacy-check.sh for everyone
# (contributors, forks, CI), on top of the private pattern list.
# One extended regex per line, matched case-sensitively unless marked (?i) below
# in the script's CI_PATTERNS. A line containing "privacy-check: ok" is skipped
# (use it for a deliberate, fictional example).
# API keys and tokens
AIza[0-9A-Za-z_-]{30,}
\bgh[pousr]_[A-Za-z0-9]{30,}
github_pat_[A-Za-z0-9_]{20,}
\bxox[abprs]-[A-Za-z0-9-]{10,}
\bsk-[A-Za-z0-9]{32,}
\bAKIA[0-9A-Z]{16}\b
eyJ[A-Za-z0-9_-]{15,}\.eyJ[A-Za-z0-9_-]{10,}
-----BEGIN [A-Z ]*PRIVATE KEY
# Home Assistant webhook IDs
/api/webhook/[A-Za-z0-9_-]{12,}
# Credentials inside a URL (rtsp://user:pass@host)
[A-Za-z][A-Za-z0-9+.-]*://[^/[:space:]:@]+:[^/[:space:]@]+@
# Email addresses
[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}
# Private and Tailscale IPv4 addresses
\b(192\.168|10\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}\b
\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b
# MAC addresses
\b([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b
