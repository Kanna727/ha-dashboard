{
  "manifest_version": 3,
  "name": "Dashboard screen power",
  "version": "1.1.0",
  "description": "Lets the wall dashboard keep a ChromeOS screen on, let it turn off, wake it, and know the battery level.",
  "minimum_chrome_version": "116",
  "permissions": ["power", "offscreen"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*/local/dashboard/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
